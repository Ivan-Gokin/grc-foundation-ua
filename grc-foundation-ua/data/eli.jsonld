   "rdfs:comment": [
    {
     "@value": "Ідентифікатори, що не починаються з http://data.europa.eu/eli/, - неофіційні: вони побудовані за шаблоном ELI цим проєктом, бо офіційного ELI в Україні поки немає.",
     "@language": "uk"
    },
    {
     "@value": "Identifiers that do not start with http://data.europa.eu/eli/ are unofficial: this project builds them on the ELI URI template because Ukraine has no official ELI yet.",
     "@language": "en"
    }
   ]
  },
